From ae96a813ca1b16d54358686d012433a5c44ace08 Mon Sep 17 00:00:00 2001
From: Martin Marmsoler <martin.marmsoler@gmail.com>
Date: Sun, 23 Mar 2025 15:39:15 +0100
Subject: [PATCH 2/4] keep program version in global.h

Reason/Description: Otherwise it must be changed twice
Files: CMakeLists.txt and global.h
---
 CMakeLists.txt | 2 --
 global.h       | 2 --
 2 files changed, 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 992ebfa..a4849d5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3,7 +3,6 @@ cmake_minimum_required(VERSION 3.23)
 
 project(DSRemote)
 set(ID "net.teuniz.dsremote")
-set(VERSION "0.42_2408061715")
 
 find_package(QT NAMES Qt4 Qt5 Qt6 REQUIRED)
 set(QT Qt${QT_VERSION_MAJOR})
@@ -82,7 +81,6 @@ set_property(TARGET ${PROJECT_NAME} PROPERTY AUTOMOC ON)
 set_property(TARGET ${PROJECT_NAME} PROPERTY AUTORCC ON)
 target_sources(${PROJECT_NAME} PRIVATE
 	FILE_SET HEADERS TYPE HEADERS BASE_DIRS ${CMAKE_CURRENT_SOURCE_DIR} FILES ${HEADERS})
-target_compile_definitions(${PROJECT_NAME} PRIVATE PROGRAM_VERSION="${VERSION}")
 
 install(TARGETS ${PROJECT_NAME})
 
diff --git a/global.h b/global.h
index 05e028c..22346f3 100644
--- a/global.h
+++ b/global.h
@@ -59,9 +59,7 @@
 
 
 #define PROGRAM_NAME          "DSRemote"
-#ifndef PROGRAM_VERSION
